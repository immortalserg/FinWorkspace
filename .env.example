# FinWorkspace Environment Configuration
# Copy this file to .env and update the values

# Application Settings
APP_NAME=FinWorkspace
APP_VERSION=1.5.0

# Security
# Generate with: openssl rand -hex 32
# Required — the app refuses to start with the placeholder default, an empty
# value, or anything shorter than 32 characters (unless DEBUG=true).
SECRET_KEY=

# Database
# Docker (inside container): sqlite:////app/data/finance.db
# Local dev: leave the Docker value OR use sqlite:///../data/finance.db — both resolve to ./data/finance.db
DATABASE_URL=sqlite:////app/data/finance.db

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins
# Leave as [] for same-origin deployments — the backend serves the frontend, which
# is the default and what Tailscale Funnel / any single-port reverse proxy needs.
# Only set explicit origins if the frontend is hosted elsewhere. A wildcard ["*"]
# is downgraded to allow_credentials=False and logged as a warning.
CORS_ORIGINS=[]

# Debug Mode — also bypasses the SECRET_KEY / NOTIFICATION_ENCRYPTION_KEY startup
# validation and re-enables permissive localhost CORS. NEVER set true in production.
DEBUG=false

# Ports — the app is served entirely from BACKEND_PORT (UI at /, API at /api).
BACKEND_PORT=8223
# FRONTEND_PORT is only used by the optional split-port dev workflow
# (python -m http.server 3100); after changing it run: npm run sync:runtime-config
FRONTEND_PORT=3100

# Notifications
NOTIFICATIONS_ENABLED=true
# Generate with: openssl rand -hex 32
# Required whenever NOTIFICATIONS_ENABLED=true. This key (not SECRET_KEY) encrypts
# per-user SMTP passwords at rest. On an EXISTING install, pin it to the current
# SECRET_KEY value before rotating SECRET_KEY, or saved SMTP passwords become
# undecryptable and users must re-enter them in Notification Settings.
NOTIFICATION_ENCRYPTION_KEY=

# SMTP (optional — per-user UI settings can override these defaults)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Web Push / VAPID (optional — generate keys with: vapid --gen  or  py-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI Chat (OpenRouter) — get an API key at https://openrouter.ai/keys
# Unset key = the AI advisor stays off. Users pick any tool-capable model from
# the OpenRouter catalogue in the chat UI; AI_DEFAULT_MODEL is used when none is chosen.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_MODEL=deepseek/deepseek-chat-v3.1
AI_MAX_OUTPUT_TOKENS=4096
# A single answer stops calling the model once its cost reaches this (USD).
AI_TURN_COST_CAP_USD=0.25
# Max model calls (tool-calling rounds) per answer before it gives up with
# "Reached maximum tool-call rounds without a final answer."
AI_CHAT_MAX_TOOL_ROUNDS=10
# Optional household-wide monthly spend cap in USD. Leave the line commented out
# for no cap (an empty value is NOT the same as unset).
# AI_MONTHLY_CAP_USD=20
# USD per 1M tokens, used only when neither OpenRouter nor the catalogue reports
# a price (the cost shown is then flagged as an estimate).
AI_FALLBACK_PRICE_IN_PER_M=1.0
AI_FALLBACK_PRICE_OUT_PER_M=4.0

# Admin bootstrap — JSON list of emails, e.g. ["you@example.com"]. Any EXISTING user (one who has
# already registered) whose email is in this list gets is_admin=True at the
# next startup. Does NOT create accounts. Registration needs an invite code, so
# create the very first admin with scripts/create_admin.py (see docs/getting-started.md).
# Once you have an admin, use the Admin page in the UI to issue invite codes.
ADMIN_EMAILS=[]

# Absolute base URL used to build links in transactional emails (password
# reset, email verification), e.g. https://your-tailnet-name.ts.net. Falls
# back to the incoming request's own origin when unset.
PUBLIC_BASE_URL=

# Operator identity shown on the public Privacy Policy (/privacy) and Terms
# (/terms) pages. Set these to YOUR details: the pages show a "not configured"
# notice until the name and email are set. Enable Banking requires these pages,
# and the email must be a mailbox you read. Jurisdiction is the country whose
# law governs the Terms (usually where you live).
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=

# Reverse-proxy trust for rate-limiting by client IP. Any reverse proxy —
# including Tailscale Funnel — makes request.client.host the PROXY's address,
# so with this false EVERY funnel visitor shares one per-IP rate-limit bucket
# and one person retrying a password can lock out everyone else.
#
# Tailscale Serve/Funnel connects from loopback and sets X-Forwarded-For to the
# real client IP, so SET THIS TO true WHEN USING FUNNEL. It is only safe if
# nothing can reach the app except tailscaled — bind the app to 127.0.0.1
# (docker compose maps 127.0.0.1:${BACKEND_PORT} by default). If the port is
# reachable directly, anyone can spoof X-Forwarded-For and bypass rate limits.
#
# Leave false only when clients connect to the app directly, with no proxy.
TRUST_PROXY_HEADERS=false

# Login / register / forgot-password rate limiting (in-process, per-IP and
# per-email sliding windows). Defaults are sane for a small friends/family
# deployment — tune only if you know you need to.
RATE_LIMIT_PER_IP_MAX=10
RATE_LIMIT_PER_IP_WINDOW_SECONDS=60
RATE_LIMIT_PER_EMAIL_MAX=5
RATE_LIMIT_PER_EMAIL_WINDOW_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# Bank sync — Enable Banking (PSD2 account information)
# ─────────────────────────────────────────────────────────────────────────────
# Pulls transactions straight from the bank instead of manual entry / CSV import.
#
# BEFORE ENABLING, three one-time steps at https://enablebanking.com:
#   1. Register a PRODUCTION application in the Control Panel. Download the
#      private key (.pem) it generates — you only get it once.
#   2. Activate it in RESTRICTED mode via "Activate by linking accounts".
#      Restricted mode is the free tier and works by WHITELISTING accounts:
#      Enable Banking compares the accounts a bank returns at authorisation
#      against the linked list and filters out everything else. Every user of
#      this app must complete that linking flow for their own accounts, in the
#      Control Panel, or their sync will return nothing at all.
#   3. Register the redirect URL below with the application.
#
# Leave BANK_SYNC_ENABLED=false to keep the whole feature inert.
BANK_SYNC_ENABLED=false
EB_API_BASE=https://api.enablebanking.com

# Application ID from the Control Panel (used as the JWT `kid`).
EB_APPLICATION_ID=

# Path to the RS256 private key. NEVER commit this or bake it into the Docker
# image — mount it as a volume. *.pem is gitignored.
EB_PRIVATE_KEY_PATH=./secrets/enablebanking.pem

# Where the bank sends the user back after SCA. Must EXACTLY match a redirect
# URL registered with Enable Banking, and must be reachable from the user's
# browser — i.e. your public Tailscale Funnel origin in production, not
# localhost. Points at this app's API, which processes the code server-side.
# e.g. https://your-tailnet-name.ts.net/api/bank-sync/callback
EB_REDIRECT_URL=

# Requested consent lifetime in days. Banks cap this (Greek ASPSPs typically at
# 90) and may grant less; whatever the bank actually returns is what gets stored.
EB_CONSENT_DAYS=90

# History requested on the first sync of a newly linked account. How far back
# the bank will actually go varies — many return far less than a year.
EB_INITIAL_HISTORY_DAYS=365

# Overlap window re-fetched on every sync. Banks backdate bookings, so syncing
# strictly "since last time" silently drops transactions. Duplicates are
# harmless — the (user_id, external_id) unique index absorbs them.
EB_SYNC_OVERLAP_DAYS=3

# Minimum gap between manual syncs of one connection. Banks rate-limit AIS hard
# (as low as 4 calls per account per day), so an impatient refresh button can
# burn the daily quota and starve the scheduled sync.
EB_MANUAL_SYNC_COOLDOWN_MINUTES=60

# Days of warning before consent expires. Re-authorisation needs the user's SCA;
# without this warning sync goes silently dark and the register stops updating.
EB_CONSENT_WARN_DAYS=7

# Absolute base URL of the frontend, used to redirect the browser back after the
# bank callback is handled. Local dev with the Vite dev server is
# http://localhost:5173; in production leave blank to reuse PUBLIC_BASE_URL.
FRONTEND_BASE_URL=

# Also import transactions the bank has not booked yet (card authorisations,
# in-flight transfers). They arrive in the same response as booked ones, so this
# costs no extra API call against your small daily quota.
#
# Off by default because pending entries are ephemeral: amounts change, entries
# vanish, and they reappear as booked entries under a DIFFERENT identifier. The
# sync copes by replacing an account's whole pending set on every run — so a
# pending row can disappear from your ledger without you deleting it, which is
# correct but surprising if you are not expecting it.
#
# Turning this on also switches the account balance to the bank's *available*
# balance (which already nets off pending) instead of the *booked* balance, so
# the account total keeps tying to the transactions shown.
#
# Not every bank reports pending entries at all; if yours does not, this does
# nothing.
EB_INCLUDE_PENDING=false

# Optional: pin a published FinWorkspace image instead of following latest.
# FINWORKSPACE_IMAGE_TAG=1.5.0
